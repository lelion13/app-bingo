# Copiar a .env.prod en el VPS (no commitear secretos).
# Ruta típica: /docker/app-bingo/.env.prod

APP_ENV=production
IMAGE_TAG=latest
CORS_ORIGINS=https://bingo.lionapp.cloud

# Obligatorio en producción (cadena larga aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo

# SQLite dentro del volumen bingo-data
DATABASE_PATH=/data/bingo.db

# Imagen: ghcr.io/lelion13/app-bingo
# Tras el primer publish en GHCR, preferí un tag fijo:
# IMAGE_TAG=sha-xxxxxxxx
